# Public runtime configuration. Never place secret keys in this file.
# Leave blank in development to derive the web-app URL from the Expo host.
# Set this to the deployed API origin for preview and production builds.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_COGNITO_USER_POOL_ID=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
EXPO_PUBLIC_COGNITO_DOMAIN=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Comma-separated: google,apple
EXPO_PUBLIC_SOCIAL_SIGN_IN=
EXPO_PUBLIC_TERMS_URL=https://startlineau.com/terms
EXPO_PUBLIC_PRIVACY_URL=https://startlineau.com/privacy
